#!/bin/sh
#
# dpi-rip-node — агент мониторинга интернет-ограничений для OpenWRT
#
# Команды:
#   daemon    — запуск в режиме демона (используется init.d)
#   check     — один цикл: получить конфиг → проверить → отправить
#   register  — принудительная (пере)регистрация ноды в панели
#   status    — показать текущие настройки

CONFIG_NAME="dpi-rip-node"
LOG_TAG="dpi-rip-node"
LOCK_FILE="/var/run/dpi-rip-node.lock"
SSE_PID_FILE="/var/run/dpi-rip-node-sse.pid"

# ── Логирование ────────────────────────────────────────────────────────────────

log()     { logger -t "$LOG_TAG" "$*"; }
log_err() { logger -t "$LOG_TAG" -p daemon.err "$*"; }

# ── Конфиг ─────────────────────────────────────────────────────────────────────

read_config() {
	PANEL_URL=$(uci -q get ${CONFIG_NAME}.settings.panel_url)
	API_KEY=$(uci -q get ${CONFIG_NAME}.settings.api_key)
	NODE_ID=$(uci -q get ${CONFIG_NAME}.settings.node_id)
	INTERVAL=$(uci -q get ${CONFIG_NAME}.settings.interval)
	TIMEOUT=$(uci -q get ${CONFIG_NAME}.settings.timeout)

	INTERVAL=${INTERVAL:-300}
	TIMEOUT=${TIMEOUT:-10}

	if [ -z "$PANEL_URL" ] || [ -z "$API_KEY" ]; then
		log_err "panel_url and api_key are required — edit /etc/config/${CONFIG_NAME}"
		exit 1
	fi
}

# ── Утилиты ────────────────────────────────────────────────────────────────────

ms_now() {
	awk '{printf "%d", $1 * 1000}' /proc/uptime
}

iso_timestamp() {
	date -u +"%Y-%m-%dT%H:%M:%SZ"
}

json_str() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# ── Блокировка (защита от параллельных циклов) ─────────────────────────────────

lock_acquire() {
	if [ -f "$LOCK_FILE" ]; then
		local pid
		pid=$(cat "$LOCK_FILE" 2>/dev/null)
		# Если процесс уже не существует — замок устарел, удаляем
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			return 1  # Цикл уже выполняется
		fi
	fi
	echo $$ > "$LOCK_FILE"
	return 0
}

lock_release() {
	rm -f "$LOCK_FILE"
}

# ── Регистрация ноды ───────────────────────────────────────────────────────────

get_mac_address() {
	local mac iface

	# Перебираем интерфейсы в порядке приоритета
	for iface in eth0 eth1 br-lan; do
		mac=$(cat "/sys/class/net/${iface}/address" 2>/dev/null)
		# Пропускаем пустые и нулевые адреса
		[ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ] && {
			printf '%s' "$mac"
			return
		}
	done

	# Fallback — первый не-loopback интерфейс
	ip link 2>/dev/null \
		| awk '/ether/{print $2}' \
		| grep -v '00:00:00:00:00:00' \
		| head -1
}

register_node() {
	local hostname model firmware mac payload response node_id

	hostname=$(uci -q get system.@system[0].hostname 2>/dev/null \
		|| cat /proc/sys/kernel/hostname 2>/dev/null \
		|| echo "unknown")
	model=$(cat /tmp/sysinfo/model 2>/dev/null || echo "unknown")
	firmware=$(. /etc/openwrt_release 2>/dev/null \
		&& echo "${DISTRIB_RELEASE:-unknown}" || echo "unknown")
	mac=$(get_mac_address)

	payload=$(printf '{"hostname":"%s","model":"%s","firmware":"%s","mac":"%s"}' \
		"$(json_str "$hostname")" \
		"$(json_str "$model")" \
		"$(json_str "$firmware")" \
		"$(json_str "$mac")")

	response=$(curl -sf --max-time "$TIMEOUT" \
		-H "X-API-Key: $API_KEY" \
		-H "Content-Type: application/json" \
		-d "$payload" \
		"${PANEL_URL}/api/v1/nodes/register" 2>/dev/null)

	if [ $? -ne 0 ] || [ -z "$response" ]; then
		log_err "Registration failed — panel unreachable or rejected the request"
		return 1
	fi

	node_id=$(echo "$response" | jsonfilter -e '@.node_id' 2>/dev/null)
	if [ -z "$node_id" ]; then
		log_err "Panel returned invalid registration response: $response"
		return 1
	fi

	uci set ${CONFIG_NAME}.settings.node_id="$node_id"
	uci commit ${CONFIG_NAME}
	NODE_ID="$node_id"

	log "Registered successfully, node_id=$node_id"
	return 0
}

# ── Получение конфига проверок ─────────────────────────────────────────────────

fetch_config() {
	local response

	response=$(curl -sf --max-time "$TIMEOUT" \
		-H "X-API-Key: $API_KEY" \
		-H "X-Node-ID: $NODE_ID" \
		"${PANEL_URL}/api/v1/nodes/config" 2>/dev/null)

	if [ $? -ne 0 ] || [ -z "$response" ]; then
		log_err "Failed to fetch config from panel"
		return 1
	fi

	echo "$response"
}

# ── Проверки ───────────────────────────────────────────────────────────────────

check_http() {
	local domain="$1"
	local t_start t_end latency http_code accessible error

	t_start=$(ms_now)

	http_code=$(curl -so /dev/null \
		--max-time "$TIMEOUT" \
		--connect-timeout 5 \
		-L \
		-w "%{http_code}" \
		"https://${domain}" 2>/dev/null)
	local exit_code=$?

	t_end=$(ms_now)
	latency=$((t_end - t_start))

	if [ $exit_code -eq 0 ] && [ "$http_code" -ge 100 ] 2>/dev/null; then
		accessible="true"
		error="null"
	else
		accessible="false"
		http_code=0
		case $exit_code in
			6)  error='"dns_failed"'        ;;
			7)  error='"connection_refused"' ;;
			28) error='"timeout"'           ;;
			35) error='"ssl_error"'         ;;
			*)  error='"unreachable"'       ;;
		esac
	fi

	printf '{"domain":"%s","accessible":%s,"http_code":%d,"latency_ms":%d,"error":%s}' \
		"$(json_str "$domain")" "$accessible" "$http_code" "$latency" "$error"
}

# ── Цикл проверок ──────────────────────────────────────────────────────────────

run_checks() {
	local config="$1"
	local results first domain result count

	local domains
	domains=$(echo "$config" | jsonfilter -e '@.targets[*].domain' 2>/dev/null)

	if [ -z "$domains" ]; then
		log_err "No targets received from panel"
		return 1
	fi

	results="["
	first=1
	count=0

	for domain in $domains; do
		[ "$first" = "1" ] || results="${results},"
		first=0

		result=$(check_http "$domain")
		results="${results}${result}"
		count=$((count + 1))

		log "$(echo "$result" | jsonfilter -e '@.accessible') ${domain} \
(http=$(echo "$result" | jsonfilter -e '@.http_code') \
lat=$(echo "$result" | jsonfilter -e '@.latency_ms')ms)"
	done

	results="${results}]"
	log "Cycle done: checked $count targets"

	echo "$results"
}

# ── Отправка результатов ───────────────────────────────────────────────────────

send_results() {
	local results="$1"
	local timestamp payload

	timestamp=$(iso_timestamp)
	payload=$(printf '{"node_id":"%s","timestamp":"%s","results":%s}' \
		"$(json_str "$NODE_ID")" "$timestamp" "$results")

	curl -sf --max-time "$TIMEOUT" \
		-H "X-API-Key: $API_KEY" \
		-H "X-Node-ID: $NODE_ID" \
		-H "Content-Type: application/json" \
		-d "$payload" \
		"${PANEL_URL}/api/v1/nodes/results" >/dev/null 2>&1

	if [ $? -ne 0 ]; then
		log_err "Failed to send results to panel"
		return 1
	fi

	log "Results sent to panel"
}

# ── Один полный цикл (с блокировкой) ──────────────────────────────────────────

run_cycle() {
	if [ -z "$NODE_ID" ]; then
		register_node || return 1
	fi

	if ! lock_acquire; then
		log "Check already running, skipping"
		return 0
	fi

	local config results
	config=$(fetch_config)
	local rc=$?

	if [ $rc -eq 0 ]; then
		results=$(run_checks "$config")
		rc=$?
	fi

	if [ $rc -eq 0 ]; then
		send_results "$results"
		rc=$?
	fi

	lock_release
	return $rc
}

# ── SSE: слушатель команд от панели ───────────────────────────────────────────

listen_events() {
	local url="${PANEL_URL}/api/v1/nodes/${NODE_ID}/stream"
	log "SSE connecting to $url"

	# curl -N отключает буферизацию — строки приходят сразу
	curl -sfN --no-buffer \
		--max-time 0 \
		-H "X-API-Key: $API_KEY" \
		-H "X-Node-ID: $NODE_ID" \
		"$url" 2>/dev/null | while IFS= read -r line; do

		# SSE формат: строки начинаются с "data: "
		echo "$line" | grep -q '^data:' || continue

		event=$(echo "$line" | sed 's/^data: *//')
		type=$(echo "$event" | jsonfilter -e '@.type' 2>/dev/null)

		case "$type" in
			check)
				log "SSE: check triggered by panel"
				read_config
				run_cycle || log_err "SSE-triggered check failed"
				;;
			config_updated)
				log "SSE: config updated on panel, will apply on next cycle"
				;;
			*)
				[ -n "$type" ] && log_err "SSE: unknown event type: $type"
				;;
		esac
	done
}

# ── Heartbeat ─────────────────────────────────────────────────────────────────

send_heartbeat() {
	curl -sf --max-time 10 \
		-H "X-API-Key: $API_KEY" \
		-H "X-Node-ID: $NODE_ID" \
		-X POST \
		"${PANEL_URL}/api/v1/nodes/heartbeat" >/dev/null 2>&1
}

run_heartbeat_loop() {
	while true; do
		send_heartbeat
		sleep 60
	done
}

# ── SSE: автоматическое переподключение ────────────────────────────────────────

run_sse_loop() {
	while true; do
		listen_events
		log_err "SSE stream disconnected, reconnecting in 30s"
		sleep 30
	done
}

# ── Режим демона ───────────────────────────────────────────────────────────────

HEARTBEAT_PID_FILE="/var/run/dpi-rip-node-hb.pid"

run_daemon() {
	log "Started (interval=${INTERVAL}s, panel=${PANEL_URL})"

	# Убеждаемся что нода зарегистрирована перед стартом фоновых процессов
	if [ -z "$NODE_ID" ]; then
		register_node || log_err "Initial registration failed, will retry in cycle"
	fi

	# Heartbeat в фоне
	run_heartbeat_loop &
	echo $! > "$HEARTBEAT_PID_FILE"

	# SSE-слушатель в фоне
	run_sse_loop &
	echo $! > "$SSE_PID_FILE"

	# Корректная остановка фоновых процессов при завершении
	trap '
		kill $(cat "$SSE_PID_FILE" 2>/dev/null) 2>/dev/null
		kill $(cat "$HEARTBEAT_PID_FILE" 2>/dev/null) 2>/dev/null
		lock_release
		exit 0
	' TERM INT

	# Периодический цикл — страховка если SSE не работает
	while true; do
		read_config
		run_cycle || log_err "Cycle failed, retrying in ${INTERVAL}s"
		sleep "$INTERVAL"
	done
}

# ── Точка входа ────────────────────────────────────────────────────────────────

case "$1" in
	daemon)
		read_config
		run_daemon
		;;
	check)
		read_config
		run_cycle
		;;
	register)
		read_config
		register_node
		;;
	status)
		read_config
		printf "panel_url : %s\n" "$PANEL_URL"
		printf "node_id   : %s\n" "${NODE_ID:-<not registered>}"
		printf "interval  : %ss\n" "$INTERVAL"
		printf "timeout   : %ss\n" "$TIMEOUT"
		;;
	*)
		echo "Usage: $0 {daemon|check|register|status}"
		exit 1
		;;
esac
