{
  "luci-app-dpi-rip": {
    "description": "DPI-RIP proxy manager",
    "read": {
      "uci":  [ "dpi-rip" ],
      "ubus": {
        "luci-rpc": [ "getGroupMembers" ],
        "session":  [ "access", "list" ]
      },
      "file": {
        "/var/log/dpi-rip*": [ "read" ],
        "/etc/dpi-rip/*":    [ "read" ],
        "/tmp/dpi-rip*":     [ "read" ]
      }
    },
    "write": {
      "uci":  [ "dpi-rip" ],
      "file": {
        "/etc/dpi-rip/*": [ "write" ],
        "/tmp/dpi-rip*":  [ "write" ]
      }
    },
    "execute": {
      "shell": [
        "/usr/bin/dpi-rip-fetch.sh",
        "/usr/bin/dpi-rip-gen.sh",
        "/usr/bin/dpi-rip-list.sh",
        "/etc/init.d/dpi-rip"
      ]
    }
  }
}
