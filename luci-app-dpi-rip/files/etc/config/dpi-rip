# /etc/config/dpi-rip
# UCI конфиг для luci-app-dpi-rip

config main
    option enabled '0'
    option active_server ''
    option proxy_mode 'tproxy'
    option bypass_cn '1'
    option dns_mode 'doh'
    option log_level 'warning'

# Серверы добавляются через LuCI / action_add_server
